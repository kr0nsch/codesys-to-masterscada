  <types>
    <dataTypes>
      <dataType name="E_ProbeState">
        <baseType>
          <enum>
            <values>
              <value name="Idle" value="0" />
              <value name="Run" value="10" />
              <value name="Fault" value="20" />
            </values>
          </enum>
        </baseType>
      </dataType>
    </dataTypes>
    <pous>
      <pou name="FB_ProbeInOut" pouType="functionBlock">
        <interface>
          <inOutVars>
            <variable name="iCount">
              <type>
                <INT />
              </type>
            </variable>
          </inOutVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">iCount := iCount + 1;
</xhtml>
          </ST>
        </body>
      </pou>
      <pou name="PRG_ProbeInOut" pouType="program">
        <interface>
          <localVars>
            <variable name="fb">
              <type>
                <derived name="FB_ProbeInOut" />
              </type>
            </variable>
            <variable name="iCount">
              <type>
                <INT />
              </type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">fb(iCount := iCount);
</xhtml>
          </ST>
        </body>
      </pou>
      <pou name="PRG_ProbeEnum" pouType="program">
        <interface>
          <localVars>
            <variable name="eState">
              <type>
                <derived name="E_ProbeState" />
              </type>
              <initialValue>
                <simpleValue value="E_ProbeState.Run" />
              </initialValue>
            </variable>
            <variable name="iOut">
              <type>
                <INT />
              </type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">CASE eState OF
    E_ProbeState.Idle:
        iOut := 0;
    E_ProbeState.Run:
        iOut := 10;
ELSE
    iOut := -1;
END_CASE;
</xhtml>
          </ST>
        </body>
      </pou>
      <pou name="FB_ProbeEn" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="EN">
              <type>
                <BOOL />
              </type>
            </variable>
          </inputVars>
          <outputVars>
            <variable name="xQ">
              <type>
                <BOOL />
              </type>
            </variable>
          </outputVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">xQ := EN;
</xhtml>
          </ST>
        </body>
      </pou>
      <pou name="PRG_ProbeNames" pouType="program">
        <interface>
          <localVars>
            <variable name="a__b">
              <type>
                <INT />
              </type>
            </variable>
            <variable name="local">
              <type>
                <INT />
              </type>
            </variable>
            <variable name="end">
              <type>
                <INT />
              </type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">a__b := 1;
local := 2;
end := a__b + local;
</xhtml>
          </ST>
        </body>
      </pou>
      <pou name="PRG_ProbePrefix" pouType="program">
        <interface>
          <localVars>
            <variable name="fb">
              <type>
                <derived name="Локальная.FB_ProbeEn" />
              </type>
            </variable>
            <variable name="xOut">
              <type>
                <BOOL />
              </type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">fb(EN := TRUE);
xOut := fb.xQ;
</xhtml>
          </ST>
        </body>
      </pou>
      <pou name="PRG_ProbeFbArray" pouType="program">
        <interface>
          <localVars>
            <variable name="aFb">
              <type>
                <array>
                  <dimension lower="0" upper="1" />
                  <baseType>
                    <derived name="FB_ProbeEn" />
                  </baseType>
                </array>
              </type>
            </variable>
            <variable name="xOut">
              <type>
                <BOOL />
              </type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">aFb[1](EN := TRUE);
xOut := aFb[1].xQ AND GVL_ProbeFb_fbShared.xQ;
</xhtml>
          </ST>
        </body>
