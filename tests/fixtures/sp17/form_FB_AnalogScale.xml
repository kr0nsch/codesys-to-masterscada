VAR_INPUT
    iRaw : INT;
    rLo : REAL := 0.0;
    rHi : REAL := 100.0;
END_VAR
VAR_OUTPUT
    rValue : REAL;
    xFault : BOOL;
END_VAR
</xhtml>
                </InterfaceAsPlainText>
              </data>
            </addData>
          </inputVars>
          <outputVars>
            <variable name="rValue">
              <type>
                <REAL />
              </type>
            </variable>
            <variable name="xFault">
              <type>
                <BOOL />
              </type>
            </variable>
            <addData>
              <data name="http://www.3s-software.com/plcopenxml/interfaceasplaintext" handleUnknown="implementation">
                <InterfaceAsPlainText>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">// Масштабирование 0..27648 → rLo..rHi; вне диапазона — неисправность, значение удерживается
FUNCTION_BLOCK FB_AnalogScale
VAR_INPUT
    iRaw : INT;
    rLo : REAL := 0.0;
    rHi : REAL := 100.0;
END_VAR
VAR_OUTPUT
    rValue : REAL;
    xFault : BOOL;
END_VAR
</xhtml>
                </InterfaceAsPlainText>
              </data>
            </addData>
          </outputVars>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml"> Масштабирование 0..27648 → rLo..rHi; вне диапазона — неисправность, значение удерживается</xhtml>
          </documentation>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">IF iRaw &lt; 0 OR iRaw &gt; 27648 THEN
    xFault := TRUE;
ELSE
    xFault := FALSE;
    rValue := F_Clamp(rIn := rLo + (rHi - rLo) * INT_TO_REAL(iRaw) / 27648.0, rMin := rLo, rMax := rHi);
END_IF
</xhtml>
          </ST>
        </body>
